# Backend API Configuration
PORT=8000
HOST=0.0.0.0

# Gemini AI API Key
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Grok AI API Key (xAI)
# Get your key from: https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# Groq API Key (Optional - for fast inference)
# Get your key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Firebase Configuration (Required for auth verification)
FIREBASE_CREDENTIALS_PATH=./service-account.json

# CORS Allowed Origins (comma-separated)
# Add your production frontend URL here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Secret for authentication (generate a secure random string)
# You can generate one with: openssl rand -hex 32
JWT_SECRET=generate_a_secure_random_string_here

# Upload Validation Limits
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=10
MAX_DOCUMENTS_PER_USER=100

# Query Validation
MAX_QUERY_LENGTH=5000
MIN_QUERY_LENGTH=1

# Development Mode (bypasses authentication for testing)
# ⚠️ WARNING: NEVER set to true in production!
# Set to "true" for local testing without Firebase
DEV_MODE=false
