# Backend API Configuration
PORT=8000
HOST=0.0.0.0

# Gemini AI API Key
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Grok AI API Key (xAI)
# Get your key from: https://console.x.ai/
GROK_API_KEY=YOUR_GROK_API_KEY_HERE

# Groq API Key (Optional - for fast inference)
# Get your key from: https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE


# Clerk JWT Verification (Required)
# Use Clerk JWT template named `convex`
CLERK_JWT_ISSUER=https://your-clerk-issuer
CLERK_JWT_AUDIENCE=convex
CLERK_JWT_SECRET=your-clerk-signing-key

# CORS Allowed Origins (comma-separated)
# Add your production frontend URL here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Secret for authentication (generate a secure random string)
# You can generate one with: openssl rand -hex 32
JWT_SECRET=generate_a_secure_random_string_here

# Upload Validation Limits
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=100
MAX_DOCUMENTS_PER_USER=100

# ===========================================
# Convex (Optional if backend only needs Clerk)
# ===========================================
CONVEX_URL=https://your-project.convex.cloud

# ===========================================
# Query Validation
# ===========================================
MAX_QUERY_LENGTH=5000
MIN_QUERY_LENGTH=1

# Development Mode (bypasses authentication for testing)
# ⚠️ WARNING: NEVER set to true in production!
DEV_MODE=false

# Admin credentials (required for /api/admin)
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password
