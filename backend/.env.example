# Backend API Configuration
PORT=8000
HOST=0.0.0.0

# Gemini AI API Key
# Get your key from: https://aistudio.google.com/app/apikey
# ⚠️ This key is for BACKEND USE ONLY - never expose in browser .env files
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Grok AI API Key (xAI)
# Get your key from: https://console.x.ai/
# Optional - for alternative model support
GROK_API_KEY=YOUR_GROK_API_KEY_HERE

# Groq API Key (Optional - for fast inference)
# Get your key from: https://console.groq.com/
# Optional - for alternative model support
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE


# Clerk JWT Verification (Required)
# Use Clerk JWT template named `convex`
# These should be set from Clerk Dashboard > JWT Templates
CLERK_JWT_ISSUER=https://your-clerk-issuer
CLERK_JWT_AUDIENCE=convex
CLERK_JWT_SECRET=your-clerk-signing-key

# CORS Allowed Origins (comma-separated)
# Add your production frontend URL here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload Validation Limits
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=100
MAX_DOCUMENTS_PER_USER=100

# ===========================================
# Convex (Optional if backend only needs Clerk)
# ===========================================
CONVEX_URL=https://your-project.convex.cloud

# ===========================================
# Query Validation
# ===========================================
MAX_QUERY_LENGTH=5000
MIN_QUERY_LENGTH=1

# Development Mode
# ⚠️ WARNING: NEVER set to true in production!
DEV_MODE=false

# ⚠️ Admin credentials REMOVED.
# Admin access is now handled via Clerk JWT claims/metadata.
# Do not set ADMIN_EMAIL/ADMIN_PASSWORD - use Clerk instead.
# If you need admin functionality, configure user metadata in Clerk
# with an "role": "admin" claim, then the backend will verify this
# via Clerk JWT verification.
