# Backend API Configuration
PORT=8000
HOST=0.0.0.0

# Gemini AI API Key
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyAsXzL-W0O7NbWLpmNyUL3sl07fzE6p3Gs

# Grok AI API Key (xAI)
# Get your key from: https://console.x.ai/
GROK_API_KEY=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

# Firebase Configuration (Optional - for backend Firebase integration)
FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Secret for authentication (generate a secure random string)
# You can generate one with: openssl rand -hex 32
JWT_SECRET=dev_secret_change_in_production_use_openssl_rand_hex_32

# Upload Validation Limits
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=10
MAX_DOCUMENTS_PER_USER=100

# Query Validation
MAX_QUERY_LENGTH=5000
MIN_QUERY_LENGTH=1

# Development Mode (bypasses authentication for testing)
# ⚠️ WARNING: NEVER set to true in production!
# Set to "true" for local testing without Firebase
DEV_MODE=false
