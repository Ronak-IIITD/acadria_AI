# StudySync AI - Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# Clerk (Auth - Required)
# Get from: Clerk Dashboard > API Keys
# ===========================================
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Convex (Database)
# Get from: Convex Dashboard > Settings
# ===========================================
VITE_CONVEX_URL=https://your-project.convex.cloud

# Backend API URL (Optional - defaults to localhost)
# Set this to your production backend URL when deploying
# ===========================================
VITE_BACKEND_URL=http://localhost:8000

# ⚠️ VITE_API_KEY intentionally removed.
# All AI functionality is routed through authenticated backend endpoints
# to prevent browser-side credential exposure. Do not set VITE_API_KEY
# unless you have a BYOK (Bring Your Own Key) architecture with encrypted
# key storage, consent, scope, quota behavior, and documentation.
