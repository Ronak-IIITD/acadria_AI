# StudySync AI - Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# Google Gemini API (Required)
# Get your key at: https://aistudio.google.com/app/apikey
# ===========================================
VITE_API_KEY=your_gemini_api_key_here

# ===========================================
# Supabase (Recommended for Auth & Database)
# Get these from: Supabase Dashboard > Settings > API
# ===========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ===========================================
# Firebase (Fallback - Optional)
# Get these from Firebase Console > Project Settings
# Only needed if Supabase is not configured
# ===========================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ===========================================
# Backend API URL (Optional - defaults to localhost)
# Set this to your production backend URL when deploying
# ===========================================
VITE_BACKEND_URL=http://localhost:8000
